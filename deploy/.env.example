# Copy to .env. Do not commit real values.
PPB_DB_USER=ppb
PPB_DB_PASSWORD=CHANGE_ME_HEX_PASSWORD
PPB_DB_NAME=ppb
PPB_JWT_SECRET=CHANGE_ME_BASE64_32_BYTES_MIN
PPB_PHIRA_CREDENTIAL_KEY=CHANGE_ME_BASE64_EXACT_32_BYTES

# OpenUDS host socket. Must exist as a socket before docker compose up.
PMP_OPENUDS_SOCKET=/var/run/pmp-openuds.sock
# Empty in direct/file-permission mode; exact PMP token in token mode.
PPB_PMP_OPENUDS_TOKEN=

API_DOMAIN=api-phira.example.com
PPF_DOMAIN=phira.example.com
PANEL_DOMAIN=panel-phira.example.com
ACME_EMAIL=admin@example.com

PPB_GITHUB_CLIENT_ID=
PPB_GITHUB_CLIENT_SECRET=
PPB_VAPID_PRIVATE_KEY_PEM=
PPB_VAPID_SUBJECT=

# Optional controlled deployment adapters. Fixed JSON argv only; no shell.
PPB_PMP_SUPERVISOR_START_JSON=
PPB_PMP_SUPERVISOR_STOP_JSON=
PPB_PMP_SUPERVISOR_ARG_SCHEMA_JSON=
PPB_PMP_SUPERVISOR_WORKDIR=
PPB_PPF_BUILD_COMMAND_JSON=
PPB_PPF_BUILD_WORKDIR=
PPB_BACKUP_COMMAND_JSON=
PPB_BACKUP_WORKDIR=
PPB_DEPLOYMENT_COMMAND_TIMEOUT_SECS=120
PPB_DEPLOYMENT_ENV_ALLOWLIST=
