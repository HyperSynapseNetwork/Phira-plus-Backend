# PPB 部署环境变量示例（NO 真实值）。复制为 /etc/ppb/ppb.env 并 chmod 600。
# 这些值由 ppctl init 生成（密码自动生成，不入参）。

# PostgreSQL
PPB_DATABASE_URL=postgres://ppb:CHANGE_ME@127.0.0.1:5432/ppb

# JWT 签名密钥（≥32 字节随机）
PPB_JWT_SECRET=CHANGE_ME

# Phira 凭据加密密钥（32 字节）
PPB_PHIRA_CREDENTIAL_KEY=CHANGE_ME

# PMP OpenUDS token（token 认证模式；approve 模式留空）
PPB_PMP_OPENUDS_TOKEN=

# 可选：GitHub OAuth（绑定用）
# PPB_GITHUB_CLIENT_ID=
# PPB_GITHUB_CLIENT_SECRET=

# 可选：Web Push VAPID（P-256 PEM + subject）
# PPB_VAPID_PRIVATE_KEY_PEM=
# PPB_VAPID_SUBJECT=
